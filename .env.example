# TT Blade Pro — Environment Configuration Example
# (Frontend-only demonstration. Configure these when connecting to WooCommerce)

# Application Port
VITE_PORT=5173

# Future WooCommerce Integration (Frontend Proxy / API endpoint)
# Note: Keep consumer secret on a secure backend proxy; do not expose secrets here!
VITE_WC_API_URL=https://your-wordpress-store.com/wp-json/wc/v3
VITE_WC_PUBLIC_KEY=

